{
  "name": "ListView",
  "path": "src/ui/ListView/ListView.tsx",
  "intent": "A list of records, one a row: a primary and a secondary line with an avatar, icon or image before them, and badges, actions, a chevron or a drag handle after, grouped under headers when the list is long, and stepping into nested lists in place.",
  "usage": "Use ListView when each record reads best as a line or two of text rather than as columns: people, invoices, messages, tasks, files. It is one component: pass items, each with an id and primary text, and optional secondary text. avatar (a name, shown as initials in a square), icon or image goes before the text; badge adds a status Badge at the end, or before the text with badgePosition start; unread puts a brand dot at the start; message adds a status line under the text; actions adds icon buttons at the end and menu puts the rest behind a More button, so a row offers the same actions as the record's Table row and Card. selection single makes a click pick one row (a light blue band between brand lines); multiple adds a checkbox to each row. interaction drill ends each row in a chevron and calls onOpen, for rows that go to a record page; drag adds a drag handle that is also a Move menu, and Alt with the arrows moves the focused row, calling onItemsChange with the new order. groups splits the list under headers: give each item a group id. size sets the header text, collapsible lets headers fold their rows away, and stickyGroups keeps each header at the top of the scrolling box while its rows pass under it. A row with children steps into its own list in place: a chevron at the end, and a click swaps the list for that row's children under a header with Back and the row's name, one level at a time, for records that hold records, like an account's invoices. With nesting expand, the children open right under the row instead, indented, like a tree. detail shows the picked record under its row, inside the list. path, defaultPath and onPathChange say which level is on screen. To show a picked record beside the list rather than going to its page, put the ListView in the ListDetail pattern. Rows are spaced like a kit Table: inset 12 at every width, the checkbox takes only its own width, and the text starts 24 after it, so a ListView and a Table of the same records line up when a screen switches between them. For columns of values that people compare use Table; for a short set of links use LinkList. See contracts/listview.json for the full contract.",
  "props": {
    "label": {
      "type": "string",
      "required": true,
      "note": "Names the list for screen readers, like Invoices."
    },
    "items": {
      "type": "ListViewItem[]",
      "required": true,
      "itemShape": {
        "id": "string",
        "primary": "string",
        "secondary": "string?",
        "group": "string? The id of the group the row sits under, when groups is set.",
        "avatar": "string? A person's name, shown as their initials in a square Avatar.",
        "icon": "string? Material Symbols name before the text, when there is no avatar.",
        "image": "string? An image URL before the text, when there is no avatar.",
        "badge": "string? A status Badge.",
        "badgeIntent": "BadgeIntent? Defaults to neutral.",
        "badgePosition": "'start' | 'end'? Before the text or at the end of the row. Defaults to end.",
        "unread": "boolean? A brand dot at the start of the row.",
        "message": "string? A short status line under the text.",
        "messageIntent": "'success' | 'info' | 'warning' | 'danger'? Defaults to info.",
        "actions": "{ id: string; label: string; icon: string }[]? Icon buttons at the end of the row. Two at most.",
        "disabled": "boolean?",
        "children": "ListViewItem[]? The row's own rows. The row ends in a chevron and a click steps into them.",
        "menu": "DropdownMenuEntry[]? The rest of the row's actions, behind one More button after the action buttons, as in a Table row."
      },
      "note": "The rows in order. With interaction drag the list keeps its own order after a move unless onItemsChange takes it back."
    },
    "onItemsChange": {
      "type": "function",
      "signature": "(items: ListViewItem[]) => void",
      "note": "Called with the new order after a drag, a Move menu pick or an Alt+arrow move."
    },
    "groups": {
      "type": "ListViewGroup[]",
      "itemShape": "{ id: string; title: string }",
      "note": "Headers in order. Each shows the items whose group is its id. Moves stay inside a group."
    },
    "size": {
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "note": "Header text: sm 14, md 16, lg 20. Headers are 48 tall at every size."
    },
    "collapsible": {
      "type": "boolean",
      "default": false,
      "note": "A chevron on each header that folds its rows away."
    },
    "stickyGroups": {
      "type": "boolean",
      "default": false,
      "note": "Each header stays at the top of the scrolling box, on a gray band, while its rows pass under it."
    },
    "collapsed": {
      "type": "string[]",
      "note": "Controlled ids of folded groups."
    },
    "defaultCollapsed": {
      "type": "string[]",
      "note": "Groups folded at first."
    },
    "onCollapsedChange": {
      "type": "function",
      "signature": "(ids: string[]) => void"
    },
    "selection": {
      "enum": [
        "none",
        "single",
        "multiple"
      ],
      "default": "none",
      "note": "single: a click picks one row, shown light blue between brand lines. multiple: a checkbox on each row; checked rows are light blue. none: rows only show, open or move."
    },
    "selected": {
      "type": "string[]",
      "note": "Controlled selected ids."
    },
    "defaultSelected": {
      "type": "string[]",
      "note": "Selected at first."
    },
    "onSelectedChange": {
      "type": "function",
      "signature": "(ids: string[]) => void"
    },
    "interaction": {
      "enum": [
        "none",
        "drill",
        "drag"
      ],
      "default": "none",
      "note": "drill: a chevron at the end; a click calls onOpen. drag: a drag handle that is also a Move menu."
    },
    "onOpen": {
      "type": "function",
      "signature": "(id: string) => void",
      "note": "With interaction drill, called with the row's id."
    },
    "onAction": {
      "type": "function",
      "signature": "(itemId: string, actionId: string) => void",
      "note": "Called when a row's action button or More menu item is picked, with the row's id and the action's id."
    },
    "path": {
      "type": "string[]",
      "note": "Controlled ids of the rows stepped into, top first. Empty shows the top level."
    },
    "defaultPath": {
      "type": "string[]",
      "note": "The level on screen at first."
    },
    "onPathChange": {
      "type": "function",
      "signature": "(ids: string[]) => void",
      "note": "Called when a row is stepped into or Back is pressed."
    },
    "nesting": {
      "enum": [
        "step",
        "expand"
      ],
      "default": "step",
      "note": "How a row with children opens them. step: the list swaps to the children, under a header with Back. expand: the children open right under the row, indented, and the row's chevron turns down; several rows can be open at once."
    },
    "expanded": {
      "type": "string[]",
      "note": "With nesting expand, controlled ids of the rows that are open."
    },
    "defaultExpanded": {
      "type": "string[]",
      "note": "With nesting expand, rows open at first."
    },
    "onExpandedChange": {
      "type": "function",
      "signature": "(ids: string[]) => void"
    },
    "detail": {
      "type": "ReactNode",
      "note": "The picked record, shown right under its row inside the list. Needs selection single; it shows under the row whose id is in selected, and the row's chevron turns down. ListDetail with layout inline passes it for you."
    }
  },
  "useWhen": [
    "People, invoices, messages or tasks that read best as a line or two of text.",
    "A list to pick one record from, or check several, before acting on them.",
    "Records that open their own page: interaction drill.",
    "An order people set by hand, like steps or priorities: interaction drag.",
    "A long list split by status, date or owner: groups.",
    "Records that hold records, browsed one level at a time: items with children."
  ],
  "doNot": [
    "Do not use it for values people compare across columns. Use Table or DataGrid.",
    "Do not use it for a short set of links. Use LinkList.",
    "Do not nest deeper than three levels, or use it for a tree people need to see at once. Use TreeView.",
    "Do not mix drill and drag in one list, or give a row more than two actions; put the rest in the record page.",
    "Do not build rows from Cards, Avatars and Buttons yourself. Use ListView.",
    "Do not use raw hex.",
    "Do not put a long record in detail. Under a row it pushes the rest of the list down; use ListDetail beside the list instead."
  ],
  "a11y": [
    "A list named by label; with groups, each header is an h3 that names its own list.",
    "single: each row is a button with aria-pressed. multiple: each row has a real checkbox named by its primary text.",
    "drill: each row is a button that opens the record, marked aria-current when it is the picked one.",
    "A collapsible header is a button with aria-expanded.",
    "drag: the handle is a Move menu button, Alt with Up, Down, Home or End moves the focused row, Shift+F10 opens the menu, and each move is announced.",
    "Action buttons are named by the action and the row, like Share Rhea Walsh; the More button is named More actions for the row. The unread dot is read as Unread.",
    "A row with children is a button; stepping in moves focus to Back, which is named after the level it returns to, and Back returns focus to the row that was opened. Each step is announced.",
    "With nesting expand, a row with children is a button with aria-expanded; its children follow it in the same list, indented. The detail under a picked row is a region named after the row."
  ],
  "snippet": "<ListView\n  label=\"Invoices\"\n  selection=\"single\"\n  interaction=\"drill\"\n  onOpen={(id) => router.push(`/invoices/${id}`)}\n  items={[\n    { id: \"inv-1042\", primary: \"INV-1042\", secondary: \"Apex Digital Services · $4,820.00\", icon: \"receipt_long\", badge: \"Overdue\", badgeIntent: \"danger\" },\n    { id: \"inv-1043\", primary: \"INV-1043\", secondary: \"Northwind Traders · $1,260.00\", icon: \"receipt_long\", badge: \"Paid\", badgeIntent: \"success\" },\n  ]}\n/>",
