{
  "name": "Select",
  "path": "src/ui/Select/Select.tsx",
  "intent": "Choose one or several options from a list. A field that opens the kit DropdownMenu. Looks like Input.",
  "usage": "Use Select to pick a value from a fixed list in a form or filter: country, status, owner, tags. One pick closes the menu; with multiple the menu stays open and each pick toggles. The field shows the picked labels; with maxVisible it shows the first few and a +N badge. Label, hint, error, help, required and sizes work like Input. For 2 to 5 options that should stay visible, use RadioGroup. See contracts/select.json for the full contract.",
  "props": {
    "label": {
      "type": "string",
      "required": true,
      "note": "Always set. With hideLabel it stays for screen readers only."
    },
    "options": {
      "type": "SelectOption[]",
      "required": true,
      "itemShape": {
        "value": "string",
        "label": "string",
        "disabled": "boolean?"
      }
    },
    "size": {
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "note": "Field height 28 / 36 / 44, same as Input. Without a size, a surrounding Density picks it: compact sm, default md, comfortable lg."
    },
    "labelPosition": {
      "enum": [
        "top",
        "start"
      ],
      "default": "top"
    },
    "itemCheck": {
      "enum": [
        "check",
        "checkbox"
      ],
      "default": "check",
      "note": "With multiple: a check on picked rows, or a kit Checkbox on every row."
    },
    "hideLabel": {
      "type": "boolean",
      "default": false
    },
    "multiple": {
      "type": "boolean",
      "default": false,
      "note": "Several values. The menu stays open; each pick toggles. value is string[]."
    },
    "placeholder": {
      "type": "string",
      "default": "Select",
      "note": "Shown in gray until something is picked."
    },
    "value": {
      "type": "string | string[]",
      "note": "Controlled. string, or string[] with multiple."
    },
    "defaultValue": {
      "type": "string | string[]",
      "note": "Uncontrolled start value."
    },
    "onChange": {
      "type": "function",
      "note": "(value: string | string[]) => void"
    },
    "maxVisible": {
      "type": "number",
      "note": "With multiple: show this many labels, then a +N badge."
    },
    "searchable": {
      "type": "boolean",
      "default": false,
      "note": "Search field at the top of the list. Filters options by label. For long lists."
    },
    "searchPlaceholder": {
      "type": "string",
      "default": "Search"
    },
    "name": {
      "type": "string",
      "note": "Hidden input for forms. Multiple submits values joined with commas."
    },
    "id": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "invalid": {
      "type": "boolean",
      "default": false
    },
    "error": {
      "type": "string",
      "note": "Message under the field. Also turns the border red."
    },
    "hint": {
      "type": "string"
    },
    "help": {
      "type": "string",
      "note": "Help icon beside the label. The text shows in a HelpPopover titled with the label, on hover, keyboard focus or click."
    }
  },
  "useWhen": [
    "Picking one value from a fixed list, like a country or status.",
    "Picking several values, like tags or owners (multiple).",
    "A long list, like countries or customers (searchable).",
    "A value in a table row (Cell type select)."
  ],
  "doNot": [
    "Do not use a native select.",
    "Do not invent SelectTrigger, SelectContent, SelectItem, MultiSelect, Combobox or Tag.",
    "Do not use for actions from a button. Use DropdownMenu.",
    "Do not use for 2 to 5 options that should stay visible. Use RadioGroup.",
    "Do not use for search across the app. Use Command.",
    "Do not use raw hex."
  ],
  "a11y": [
    "The field is a button with aria-haspopup=menu, named by the label and the current value, like Country, Serbia.",
    "The list is the kit DropdownMenu: one pick is a menuitemradio, multiple picks are menuitemcheckbox, with aria-checked.",
    "With searchable, focus starts in the search field; Arrow Down moves into the list and Enter picks the first match.",
    "Arrow keys move, Enter or Space picks, Escape closes and returns focus to the field.",
    "Required is read from the label; error and hint are linked with aria-describedby."
  ],
  "snippet": "<Select label=\"Country\" placeholder=\"Select a country\" options={countries} value={country} onChange={setCountry} />",
  "examples": [
