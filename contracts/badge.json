{
  "name": "Badge",
  "path": "src/ui/Badge/Badge.tsx",
  "intent": "Short status or category label. Not a person and not a button.",
  "usage": "Use Badge for status on rows and cards, and for category or filter labels. Pick the tone from meaning and the emphasis from how loud it should be: subtle is the default, strong for the one thing that must stand out, faint for quiet lists. Only dismissible filters are removable. sm (20px) is the BP Components badge and the default; md and lg are larger kit sizes for roomier layouts. See contracts/badge.json for the full contract.",
  "props": {
    "tone": {
      "enum": [
        "neutral",
        "hollow",
        "info",
        "success",
        "warning",
        "danger",
        "highlight"
      ],
      "default": "neutral",
      "note": "hollow = outline only. highlight = purple, for new or featured."
    },
    "emphasis": {
      "enum": [
        "subtle",
        "strong",
        "faint"
      ],
      "default": "subtle",
      "note": "strong = solid color with white text."
    },
    "size": {
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "default": "sm",
      "note": "sm 20px = the BP Figma badge (12px text). md 24px (12px text). lg 28px (14px text). md and lg are kit-defined."
    },
    "icon": {
      "type": "string",
      "note": "Material Symbols name. Leading icon (12px, 16px at lg), or the only content when iconOnly."
    },
    "iconOnly": {
      "type": "boolean",
      "default": false,
      "note": "Square badge (20 / 24 / 28 px) with one icon. children becomes the hidden label."
    },
    "removable": {
      "type": "boolean",
      "default": false,
      "note": "Adds a 12px close button that calls onRemove."
    },
    "disabled": {
      "type": "boolean",
      "default": false,
      "note": "Gray with faint text in every tone. The close button does not fire."
    },
    "children": {
      "type": "string",
      "required": true,
      "note": "One to three words. Also the label for icon-only badges."
    },
    "onRemove": {
      "type": "function",
      "note": "Called by the close button when removable."
    }
  },
  "useWhen": [
    "Status on table rows or cards.",
    "Category markers and filter labels.",
    "A count or marker next to a title, like New."
  ],
  "doNot": [
    "Do not invent a local Badge, Tag, Chip or Pill.",
    "Do not use as a button or link. Only the close button is interactive.",
    "Do not use for people. Use Avatar.",
    "Do not put sentences in a Badge.",
    "Do not use more than one strong Badge in a row or card.",
    "Do not use raw hex.",
    "Do not mix badge sizes in one row."
  ],
  "a11y": [
    "Text carries the meaning; tone color is never the only signal.",
    "Icon-only badges keep children as visually hidden text.",
    "disabled sets aria-disabled.",
    "The close control is a native button labeled Remove {children}, with a focus ring. When disabled, it is disabled too."
  ],
  "snippet": "<Badge tone=\"success\">Paid</Badge>",
  "examples": [
