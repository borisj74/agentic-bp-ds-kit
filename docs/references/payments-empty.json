{
  "name": "payments-empty",
  "title": "Payments and refunds",
  "about": "The reference empty screen: a list that has no records yet, with the one action that starts the first one. The ready state is there too, so the screen can be compared with and without rows.",
  "pattern": "ListPage",
  "section": "ar-payments-refunds",
  "state": "empty",
  "states": ["empty", "ready"],
  "copy": {
    "emptyTitle": "No payments yet",
    "emptyDescription": "Payments appear here as soon as one is recorded against an invoice. Record the first one, or import a bank file.",
    "primary": "Record payment",
    "secondary": "Import bank file",
    "searchPlaceholder": "Search payment or account"
  },
  "regions": {
    "toolbar": [
      {
        "component": "Toolbar",
        "props": {
          "label": "Payments",
          "searchPlaceholder": "$copy.searchPlaceholder",
          "onSearchChange": true,
          "onRefresh": true
        },
        "slots": {
          "actions": [
            {
              "component": "Button",
              "props": { "size": "sm", "emphasis": "strong", "intent": "brand", "iconStart": "add" },
              "text": "$copy.primary"
            }
          ]
        }
      }
    ],
    "content": [
      {
        "component": "Table",
        "props": {
          "caption": "Payments recorded against invoices.",
          "rowLabel": "payment",
          "emptyLabel": "No payments yet",
          "columns": [
            { "key": "payment", "header": "Payment", "emphasis": true },
            { "key": "account", "header": "Account" },
            { "key": "method", "header": "Method" },
            { "key": "received", "header": "Received" },
            { "key": "amount", "header": "Amount", "numeric": true }
          ],
          "rows": [
            { "id": "pay-2041", "payment": "PAY-2041", "account": "Northwind Holdings", "method": "ACH", "received": "Nov 12, 2026", "amount": "$18,400.00" },
            { "id": "pay-2042", "payment": "PAY-2042", "account": "Helios Cloud", "method": "Card", "received": "Nov 14, 2026", "amount": "$4,120.00" },
            { "id": "pay-2043", "payment": "PAY-2043", "account": "Globex Corporation", "method": "Wire", "received": "Nov 17, 2026", "amount": "$32,006.00" }
          ]
        }
      }
    ],
    "empty": [
      {
        "component": "EmptyState",
        "props": {
          "headingLevel": 2,
          "icon": "payments",
          "iconStyle": "well",
          "title": "$copy.emptyTitle",
          "description": "$copy.emptyDescription"
        },
        "slots": {
          "actions": [
            {
              "component": "Button",
              "props": { "size": "sm", "iconStart": "upload_file" },
              "text": "$copy.secondary"
            }
          ]
        }
      }
    ]
  }
}
